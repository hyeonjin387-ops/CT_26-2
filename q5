#include <stdio.h>
#define MAX 50000

int parent[50000];

int find_root(int i) {
    if (parent[i] == i)
        return i;
    return parent[i] = find_root(parent[i]);
}

int union_set(int i, int j) {
    int root_i = find_root(i);
    int root_j = find_root(j);
    
    if (root_i != root_j) {
        parent[root_j] = root_i;
        return 1;
    }
    return 0;
}

int main(){
    int n,m;

    scanf("%d %d",&n,&m);

    for (int i = 1; i <= n; i++) {
        parent[i] = i;
    }
    
    int group = n;

    for(int a=0; a<m; a++){
        int i,j;
        scanf("%d %d", &i, &j);
        if(union_set(i,j)){
            group--;
        }
    }
    printf("%d",group);

    return 0;
    
}
